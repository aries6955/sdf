# sdf 的配置:改名成 .env 放在与本文件同一目录,docker compose 自动读取。
# 权限设为 600 —— 里面有 R2 密钥。

# 登录密码。改完执行 docker compose up -d 生效。
# 忘密:用 SDF_SUPER_PASSWORD 登录后到「设置」页;或直接把这里改掉重启。
SDF_PASSWORD=change-me

# 忘密恢复入口。不设就没有这条后门;设了请用长随机串
# SDF_SUPER_PASSWORD=

# Cloudflare R2 异地备份。四项缺任一就不备份(退出码 0,静默跳过)
SDF_R2_ACCOUNT_ID=
SDF_R2_ACCESS_KEY_ID=
SDF_R2_SECRET_ACCESS_KEY=
SDF_R2_BUCKET=

# R2 里保留多少天的快照
SDF_KEEP_DAYS=30
